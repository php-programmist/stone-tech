<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=0">
        <title>{% block title %}{% endblock %}</title>
        <meta name="description" content="{% block description %}{% endblock %}">
        {% block lastMod %}<meta http-equiv="Last-Modified" content="{{ page.updated|date('D, d M Y H:i:s') }} GMT">{% endblock %}
        {% block canonical %}<link rel="canonical" href="{{ app.request.schemeAndHttpHost~'/'~page.path }}"/>{% endblock %}
        {% block scheme %}
            <meta property="og:title" content="{{ block('title') }}"/>
            <meta property="og:description" content="{{ block('description') }}"/>
            <meta property="og:url" content="{{ app.request.schemeAndHttpHost~'/'~page.path }}"/>
            <meta property="og:image" content="{{ app.request.schemeAndHttpHost }}/img/header/logo1.png"/>
        {% endblock %}
        <link rel="shortcut icon" href="{{ asset('favicon.png') }}" type="image/x-icon">

        {# Run `composer require symfony/webpack-encore-bundle`
           and uncomment the following Encore helpers to start using Symfony UX #}
        {% block stylesheets %}
            <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.1/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-+0n0xVW2eSR5OomGNYDnhzAbDsOXxcvSN1TPprVMTNDbiYZCxYbOOl7+AMvyTG2x" crossorigin="anonymous">
            <link href="{{ asset('css/style.css') }}" rel="stylesheet" type="text/css"/>
            <link rel="stylesheet" type="text/css" href="{{ asset('slick/slick.css') }}"/>
            <link rel="stylesheet" type="text/css" href="{{ asset('css/whatsapp/whatsapp.css') }}"/>

            <!-- Подключение FONTAWESOME-->

            <link rel="stylesheet" href="{{ asset('font-awesome-4.6.3/css/font-awesome.min.css') }}">


            <!-- Подключение галереи -->
            <link href='https://fonts.googleapis.com/css?family=Slabo+27px' rel='stylesheet' type='text/css'>
            <link href="{{ asset('css/slider.css') }}" rel='stylesheet' type='text/css'>
            <!-- Подключение ПОПАП -->

            <link rel="stylesheet" href="{{ asset('css/template.css') }}" type="text/css"/>
            <link rel="stylesheet" type="text/css" href="{{ asset('css/slider.css') }}">
            <link rel="stylesheet" href="{{ asset('css/videofon.css') }}" type="text/css"/>

            <link rel="stylesheet" type="text/css" href="{{ asset('css/rating/rating.css') }}"/>
            <link rel="stylesheet" type="text/css" href="{{ asset('css/rating/stars.css') }}"/>
            {#{{ encore_entry_link_tags('app') }}#}
        {% endblock %}

        {% block javascripts %}
            <script type="text/javascript" src="{{ asset('js/jquery-3.1.0.min.js') }}"></script>
            <script type="text/javascript" src="{{ asset('js/script.js') }}"></script>
            <script type="text/javascript" src="{{ asset('js/jquery.imagesGrid.js') }}"></script>
            <script type="text/javascript" src="{{ asset('js/crawler_min.js') }}"></script>
            <script type="text/javascript" src="{{ asset('js/td.js') }}"></script>
            <script src="https://cdnjs.cloudflare.com/ajax/libs/modernizr/2.8.3/modernizr.min.js"></script>
            <script src="{{ asset('js/maskedinput.js') }}"></script>
            <script type="text/javascript" src="{{ asset('slick/slick.min.js') }}"></script>
            <script type="text/javascript" src="{{ asset('js/popup.js') }}"></script>
            <!-- Подключение СЛАЙДЕРА -->
            <script src="{{ asset('js/jquery.glide.js') }}"></script>

            {#{{ encore_entry_script_tags('app') }}#}
            <!-- Yandex.Metrika counter -->
            <script type="text/javascript">(function(d,w,c){(w[c]=w[c]||[]).push(function(){try{w.yaCounter45813690=new Ya.Metrika({id:45813690,clickmap:true,trackLinks:true,accurateTrackBounce:true,webvisor:true});}catch(e){}});var n=d.getElementsByTagName("script")[0],s=d.createElement("script"),f=function(){n.parentNode.insertBefore(s,n);};s.type="text/javascript";s.async=true;s.src="https://mc.yandex.ru/metrika/watch.js";if(w.opera=="[object Opera]"){d.addEventListener("DOMContentLoaded",f,false);}else{f();}})(document,window,"yandex_metrika_callbacks");</script>
            <noscript><div><img src="https://mc.yandex.ru/watch/45813690" style="position:absolute; left:-9999px;" alt="" data-pagespeed-url-hash="2921145116"/></div></noscript>
            <!-- /Yandex.Metrika counter -->

            <script type="text/javascript" src="{{ asset('js/yandex-targets.js') }}"></script>
        {% endblock %}
    </head>
    <body>
            {% block topmenu %}
                {# top menu #}
                {#{{ include('elements/top_menu.html.twig') }}#}
                {{ render(controller('App\\Widget\\TopMenu::show')) }}
            {% endblock %}

            {% block header %}
            {% endblock %}

            {% block body %}
            {% endblock %}

            {% block askQuestion %}
                {{ include('elements/ask_question.html.twig') }}
            {% endblock %}

            {% block footer %}
                {{ include('elements/footer.html.twig') }}
                {{ include('elements/popup.html.twig') }}
                {{ include('elements/cd-user-modal.html.twig') }}
                <a href="#" class="scrollup">Наверх</a>
            {% endblock %}

            <a class="wapopup" target="_blank" href="https://wa.me/79857600280?text=Прошу%20оценить%20стоимость" data-href="whatsapp">
                <div class="wapopup__content"><img src="/css/whatsapp/whatsapp.svg" alt="" data-pagespeed-url-hash="3160325871" onload="pagespeed.CriticalImages.checkImageForCriticality(this);">
                    <div class="wapopup__content__text">
                        <div>Оцените стоимость</div>
                        <div><span>по WhatsApp</span></div>
                    </div>
                </div>
            </a>
    </body>

